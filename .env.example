# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Prisma reads `.env`, and Next.js reads it too, so DB and app vars live together here.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the web app (used for auth callbacks, absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = "Transaction" pooler URL (port 6543); append ?pgbouncer=true.
# DIRECT_URL   = direct/session URL (port 5432), used by Prisma Migrate.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Real-time collab server ──────────────────────────────────────────────────
# WebSocket URL the browser connects to. Empty = editor runs offline-only.
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
# Shared secret for signing short-lived collab tokens (added in the next phase).
# COLLAB_TOKEN_SECRET=""

# ── AI (added in Phase 9) ────────────────────────────────────────────────────
# GOOGLE_GENERATIVE_AI_API_KEY=""
