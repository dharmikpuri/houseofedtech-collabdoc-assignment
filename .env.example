# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Prisma reads `.env`, and Next.js reads it too, so DB and app vars live together here.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the web app (used for absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string.
# Use the DIRECT / session connection (port 5432) for BOTH URLs. The app uses
# Prisma interactive transactions, which need a session-mode connection — the
# transaction pooler won't work.
DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Real-time collab server ──────────────────────────────────────────────────
# WebSocket URL the browser connects to. Empty = editor runs offline-only.
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
# Shared secret for signing/verifying short-lived collab tokens. MUST match the
# value the collab-server uses. Generate with: openssl rand -base64 32
COLLAB_TOKEN_SECRET=""
# Port the collab-server listens on (defaults to 1234 if unset).
# PORT="1234"

# ── AI (optional) ────────────────────────────────────────────────────────────
# Google Gemini key for the AI features (summaries, Q&A, rewrites, autocomplete,
# semantic search). Get one at https://aistudio.google.com. If unset, AI
# features explain that they're off instead of failing.
GEMINI_API_KEY=""
# Override the model (defaults to gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"
# Embedding model for semantic search (768-dim vectors; defaults to gemini-embedding-001).
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# ── Production services (all optional; each degrades gracefully if unset) ────
# Shared rate limiting across instances (Upstash Redis REST). Without these,
# limits are kept in process memory — fine for a single server.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Error reporting. With a Sentry DSN, server and browser errors are sent to
# Sentry; without it they are only logged.
# SENTRY_DSN=""
# LOG_LEVEL="info"

# Password-reset email via Resend. Without these, reset links are printed to the
# server log in development and "Forgot password?" is hidden in production.
# RESEND_API_KEY=""
# EMAIL_FROM="CollabDoc <no-reply@yourdomain.com>"

# ── Collab server limits (optional) ─────────────────────────────────────────
# Largest single WebSocket message, and the document size after which the
# server stops accepting writes (reads keep working). Defaults: 4 MB / 8 MB.
# COLLAB_MAX_MESSAGE_BYTES="4194304"
# COLLAB_MAX_DOCUMENT_BYTES="8388608"

# ── Demo account (optional) ──────────────────────────────────────────────────
# Used by `npm run seed:demo`. SHOW_DEMO_LOGIN=true adds a one-click
# "Try the demo account" button to the sign-in page — it publishes the demo
# password, so only enable it for the dedicated demo account.
# DEMO_EMAIL="demo@collabdoc.dev"
# DEMO_PASSWORD=""
# SHOW_DEMO_LOGIN="false"
