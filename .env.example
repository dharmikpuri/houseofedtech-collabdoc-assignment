# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Prisma reads `.env`, and Next.js reads it too, so DB and app vars live together here.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the web app (used for absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# From Supabase → Project Settings → Database → Connection string.
# Use the DIRECT / session connection (port 5432) for BOTH URLs. The app uses
# Prisma interactive transactions, which need a session-mode connection — the
# transaction pooler won't work.
DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
# Session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Real-time collab server ──────────────────────────────────────────────────
# WebSocket URL the browser connects to. Empty = editor runs offline-only.
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
# Shared secret for signing/verifying short-lived collab tokens. MUST match the
# value the collab-server uses. Generate with: openssl rand -base64 32
COLLAB_TOKEN_SECRET=""
# Port the collab-server listens on (defaults to 1234 if unset).
# PORT="1234"

# ── AI (optional) ────────────────────────────────────────────────────────────
# Google Gemini key for "What changed since?" version summaries. Get one at
# https://aistudio.google.com. If unset, the AI feature is simply hidden.
GEMINI_API_KEY=""
# Override the model (defaults to gemini-2.5-flash).
# GEMINI_MODEL="gemini-2.5-flash"
