# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
# Only the variables the app actually reads are listed; each phase adds its own.

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the web app (used for auth callbacks, absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (added in Phase 3) ──────────────────────────────────────────────
# PostgreSQL connection string, e.g. from Neon. Pooled URL for the app runtime.
# DATABASE_URL=""
# Direct (non-pooled) URL for Prisma migrations.
# DIRECT_URL=""

# ── Auth (added in Phase 2) ──────────────────────────────────────────────────
# Secret used to sign JWT sessions. Generate with: openssl rand -base64 32
# AUTH_SECRET=""
# GitHub OAuth app credentials.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ── Real-time collab server (added in Phase 6) ───────────────────────────────
# WebSocket URL the browser connects to for real-time sync.
# NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
# Shared secret used to sign short-lived collab tokens (app + collab server).
# COLLAB_TOKEN_SECRET=""

# ── AI (added in Phase 9) ────────────────────────────────────────────────────
# Google Gemini API key (via the Vercel AI SDK).
# GOOGLE_GENERATIVE_AI_API_KEY=""
